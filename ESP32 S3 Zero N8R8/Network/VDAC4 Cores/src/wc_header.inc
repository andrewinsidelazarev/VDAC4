; Заголовок .WMF для Wild Commander, формат #0A.
; Плагин запускается из меню плагинов (F10) и занимает одну страницу #8000. Заголовок занимает
; 512 байтов.

        ds 16
        db "WildCommanderMDL"
        db #0A
        db 0
        db 1                          ; всего страниц: код
        db 0                          ; страница 0 подключается по адресу #8000

        ; Пары [страница, число 512-байтных секторов с округлением вверх]; пара с нулём
        ; секторов кончает список.
        db 0,(mainEnd-mainStart+511)/512
        db 0,0
        db 0,0
        db 0,0
        db 0,0
        db 0,0

        ds 16
        db "NES"
        ds 31*3
        db 0
        dd #FFFFFFFF                  ; файл читает плагин, WC не грузит его в RAM

.plugin_name
        db "VDAC4 Cores v0.13"
        ds 32-($-.plugin_name),' '
        db #05                        ; меню F10, просмотрщик и расширение .NES
        ds 6
        db "Play NES cartridge      "
        ds 32
