// Таблица смешения двух кадров (FRAME BLEND, fb_core). СГЕНЕРИРОВАНО scripts/gen_avg_tab.py —
// не править руками. i = {канал кадра 1, канал кадра 2}, канал — {PAL_SEL, значение 5 бит};
