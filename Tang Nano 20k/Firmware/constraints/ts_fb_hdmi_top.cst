// Физические ограничения прошивки с кадровым буфером (ts_fb_hdmi_top): Tang Nano 20K (GW2AR-LV18QN88C8/I7) на carrier A3.1.
//
// Номера выводов carrier взяты из docs/a3-interface-pinmap.md (столбец FPGA),
// выводы HDMI, кнопки и усилителя — из примеров Sipeed для Tang Nano 20K.
// Не занимать здесь выводы 49 и 51 под carrier: 49 — бортовой, 51 — PA_EN усилителя.

// ---------------------------------------------------------------------------
// Видео с мультиплексоров U1/U2 (3,3 В, приходят через гребёнки J5/J6 модуля)
// ---------------------------------------------------------------------------
IO_LOC  "mux_d[0]" 27;
IO_PORT "mux_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "mux_d[1]" 28;
IO_PORT "mux_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "mux_d[2]" 29;
IO_PORT "mux_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "mux_d[3]" 30;
IO_PORT "mux_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "mux_d[4]" 41;
IO_PORT "mux_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "mux_d[5]" 42;
IO_PORT "mux_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "mux_d[6]" 48;
IO_PORT "mux_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "mux_d[7]" 54;
IO_PORT "mux_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Управление выбором фазы мультиплексора: меандр 28 МГц
IO_LOC  "mux_sel" 56;
IO_PORT "mux_sel" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;

// ---------------------------------------------------------------------------
// Синхронизация и тактирование входа (через U3)
// ---------------------------------------------------------------------------
IO_LOC  "hsync_in" 15;
IO_PORT "hsync_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "vsync_in" 16;
IO_PORT "vsync_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// PCLK от Evo; вывод 80 — глобальный клоковый вход GCLKT_0
IO_LOC  "pclk_in" 80;
IO_PORT "pclk_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Режим порта: 0 — базовое видео TS-Config, 1 — эмуляция FT812
IO_LOC  "m_sel" 73;
IO_PORT "m_sel" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---------------------------------------------------------------------------
// FT812: SPI хоста Evo (общая шина Z-контроллера; FT_CS_N — порт #77 бит 2)
// ---------------------------------------------------------------------------
// SCK — не глобальный клоковый вывод: приёмник ft_spi тактируется им через общую трассировку
IO_LOC  "ft_sck" 20;
IO_PORT "ft_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "ft_cs_n" 17;
IO_PORT "ft_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "ft_mosi" 19;
IO_PORT "ft_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// MISO: U6 берёт его только при выбранном FT812, без выбора — 0 (на Tang это DIN WS2812)
IO_LOC  "ft_miso" 79;
IO_PORT "ft_miso" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_LOC  "ft_int_n" 74;
IO_PORT "ft_int_n" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;

// ---------------------------------------------------------------------------
// Сопроцессор FT812 на BL616 модуля (Tang Nano 20K rev 3923, как у NextNano/MiSTle):
// BL616 — ведущий SPI. На rev 3921 MISO и MOSI — другие выводы BL616 (GPIO2, GPIO3).
// ---------------------------------------------------------------------------
// SCK — не глобальный клоковый вывод: cp_spi тактируется им через общую трассировку
IO_LOC  "cp_sck" 13;
IO_PORT "cp_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "cp_cs_n" 86;
IO_PORT "cp_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "cp_mosi" 76;
IO_PORT "cp_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "cp_miso" 75;
IO_PORT "cp_miso" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_LOC  "cp_irq_n" 69;
IO_PORT "cp_irq_n" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;

// ---------------------------------------------------------------------------
// LINK_IRQ_N: в этой прошивке не ведётся
// ---------------------------------------------------------------------------
IO_LOC  "link_irq_n" 85;
IO_PORT "link_irq_n" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;

// ---------------------------------------------------------------------------
// LINK к ESP32-S3: QSPI, ESP — ведущий (docs/a3-interface-pinmap.md)
// ---------------------------------------------------------------------------
IO_LOC  "link_sck" 77;
IO_PORT "link_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "link_cs_n" 18;
IO_PORT "link_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "link_io[0]" 71;
IO_PORT "link_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "link_io[1]" 72;
IO_PORT "link_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "link_io[2]" 55;
IO_PORT "link_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "link_io[3]" 31;
IO_PORT "link_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// ---------------------------------------------------------------------------
// SPI-flash Tang (выводы MSPI): настройки и мост к flash для ESP (fb_flash)
// ---------------------------------------------------------------------------
IO_LOC  "flash_sck" 59;
IO_PORT "flash_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "flash_cs_n" 60;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "flash_mosi" 61;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "flash_miso" 62;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------------------------------------------------------------------
// microSD Tang (режим SPI): мост для ESP (fb_sdspi, ядро 1.30, только TS-Config). DAT1/DAT2
// слота (85, 80) на VDAC4 — link_irq_n и pclk_in; в режиме SPI карта их не ведёт
// ---------------------------------------------------------------------------
IO_LOC  "sd_cs_n" 81;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_mosi" 82;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_sck" 83;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_miso" 84;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------------------------------------------------------------------
// Бортовое: кнопки S1/S2 экранного меню и запрет усилителя звука
// Активный уровень кнопок определяет прошивка (уровень после включения = «не нажата»),
// поэтому подтяжки ПЛИС нет: кнопки модуля имеют свои резисторы.
// ---------------------------------------------------------------------------
IO_LOC  "btn[0]" 88;
IO_PORT "btn[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "btn[1]" 87;
IO_PORT "btn[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// RECONFIG_N (на плате — только TP1): ядро тянет к 0 для multiboot (регистр BOOT),
// в покое — Z и подтяжка, как у вывода конфигурации
IO_LOC  "reconfig_n" 9;
IO_PORT "reconfig_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "pa_en" 51;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=DOWN;

// ---------------------------------------------------------------------------
// HDMI: дифференциальные пары TMDS (эмулированный LVDS: ELVDS_OBUF + LVCMOS33D)
// ---------------------------------------------------------------------------
IO_LOC  "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_data_p[0]" 35,36;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_data_p[1]" 37,38;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_data_p[2]" 39,40;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;

// ---------------------------------------------------------------------------
// Кварц Tang Nano 20K 27 МГц — источник развёртки 576p50 и SDRAM
// ---------------------------------------------------------------------------
IO_LOC  "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// Встроенная SDRAM (O_sdram_*, IO_sdram_dq) выводов не требует: имена портов
// распознаются Gowin для GW2AR-18.
