	(text "Half-duplex QSPI: ESP master / Tang slave; bidirectional IO0..3 plus SCK, CS_N, IRQ_N." (at 18 18 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "d89416c5-3855-5c2e-a890-679a70f12678"))
	(text "LINK_SCK: FPGA77 / J6.5 / GCLKT_1. Separate FT_INT_N: FPGA74 / J6.2." (at 18 26 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "1e62ac9a-74d7-5436-9053-169c1048ed1f"))
	(text "Rev 0: Tang on J6/J7 (2 x 1x20), ESP on J8/J9 (2 x 1x9); female sockets on TOP, modules removable." (at 18 34 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "ef9aaa48-ee44-5e0a-8522-096c1d7ddf1d"))
	(text "A1 uses header contacts only. Do not connect LCD FPC, SD card or speaker." (at 18 141 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "20027520-aa1a-5ea9-bc23-ca1bdfdb021a"))
	(text "Tang GPIO49/51: no carrier connection. FPGA top must drive onboard EN outputs LOW after configuration." (at 18 149 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "7c0e949b-cfc6-524e-9a41-bd41f5207f60"))
	(text "HDMI CEC/HPD/DDC and BL616 lines are reserved. No module rework and no ESP live-JTAG." (at 18 157 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "c3e71b12-6260-525b-b9eb-1fccd04b36e2"))
	(text "ESP SPI2 slave: GPIO10/11/12/13 (Evo). SPI3 QSPI master: CS=3 CLK=5 IO0..3=4/7/6/44." (at 18 211 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "6a2f447a-e62d-56a8-9554-34992e2fc3cc"))
	(text "R10 holds GPIO3/CS HIGH during reset (USB JTAG strap). UART removed; GPIO43 NC; I2S=1/2/8." (at 18 220 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "0e0dd25f-d3d2-5e1f-8f2d-8bf85edbf19c"))
	(text "Tang drives LINK_IO only when returning data to ESP; high-Z when CS_N=HIGH. Allow turnaround." (at 18 228 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "7d932916-f055-5319-bd44-3059d135b4ae"))
	(text "FPGA85 has a board 10k pull-up (LINK_IRQ_N). FPGA79 has a board 5.1k pull-down (Evo MISO)." (at 18 236 0)
		(effects (font (size 1.5 1.5)) (justify left top))
		(uuid "4a217302-349d-5f58-8316-53263c9ae238"))
	(embedded_fonts no)
)
