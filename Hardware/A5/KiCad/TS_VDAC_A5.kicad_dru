(version 1)
# Generated by Tools/a3_routing.py; edit the generator, then regenerate.
(rule "In2.Cu reserved for ground reference"
  (layer "In2.Cu")
  (constraint disallow track))
(rule "Only ground pours on inner layers"
  (layer inner)
  (condition "A.NetName != 'GND' && A.NetName != 'A_GND'")
  (constraint disallow zone))
(rule "Through vias only"
  (constraint disallow micro_via blind_via buried_via))
(rule "Power branch minimum and preferred width"
  (condition "A.hasNetclass('Power') || A.hasNetclass('PowerInput')")
  (constraint track_width (min 0.25mm) (opt 0.5mm)))
(rule "Fused input trunk"
  (condition "A.NetName == '+5V_IN'")
  (constraint track_width (min 0.8mm) (opt 1mm)))
(rule "Module supply trunks"
  (condition "A.NetName == 'TANG_5V' || A.NetName == 'ESP_5V'")
  (constraint track_width (min 0.5mm) (opt 0.8mm)))
(rule "QSPI point-to-point carrier length allocation"
  (condition "A.NetName == 'LINK_SCK' || A.NetName == 'LINK_IO*'")
  (severity warning)
  (constraint length (max 100mm)))
(rule "Mux to Tang carrier length allocation"
  (condition "A.NetName == 'MUX_D*'")
  (severity warning)
  (constraint length (max 60mm)))
(rule "IDE15 resistor near return driver"
  (condition "A.NetName == 'FT_INT_5V_DRV'")
  (constraint length (max 10mm)))
